\
  <div id="groupList" class="space-y-4"></div>\
\
  <script>\
    const defaultData = \{\
      title: "\uc0\u26085 \u26412 \u36092 \u29289 \u33287 \u20195 \u36092 \u31558 \u35352 ",\
      subtitle: "\uc0\u40670 \u25802 \u27492 \u34389 \u21487 \u20462 \u25913 \u21103 \u27161 \u38988 \u33287 \u20633 \u35387 \u35498 \u26126 ",\
      groups: [\
        \{\
          id: 'g1',\
          name: '\uc0\u34277 \u22941 \u24215 ',\
          collapsed: false,\
          items: [\
            \{ id: 'i1', name: '\uc0\u36039 \u29983 \u22530 \u21560 \u27833 \u38754 \u32025 ', note: '', price: '', image: '', checked: false \},\
            \{ id: 'i2', name: 'Love Liner \uc0\u30473 \u31558 ', note: '\u33258 \u28982 \u26837 ', price: '1200', image: '', checked: false \}\
          ]\
        \}\
      ]\
    \};\
\
    let appData = JSON.parse(localStorage.getItem('handbook_shopping_data')) || defaultData;\
\
    function saveData() \{\
      localStorage.setItem('handbook_shopping_data', JSON.stringify(appData));\
      render();\
    \}\
\
    const appTitleEl = document.getElementById('appTitle');\
    const appSubTitleEl = document.getElementById('appSubTitle');\
    appTitleEl.innerText = appData.title || "\uc0\u26085 \u26412 \u36092 \u29289 \u33287 \u20195 \u36092 \u31558 \u35352 ";\
    appSubTitleEl.innerText = appData.subtitle || "\uc0\u40670 \u25802 \u27492 \u34389 \u21487 \u20462 \u25913 \u21103 \u27161 \u38988 \u33287 \u20633 \u35387 \u35498 \u26126 ";\
\
    appTitleEl.addEventListener('blur', () => \{ appData.title = appTitleEl.innerText.trim() || "\uc0\u26410 \u21629 \u21517 \u28165 \u21934 "; saveData(); \});\
    appSubTitleEl.addEventListener('blur', () => \{ appData.subtitle = appSubTitleEl.innerText.trim(); saveData(); \});\
\
    function render() \{\
      const groupList = document.getElementById('groupList');\
      groupList.innerHTML = '';\
      let totalItems = 0, completedItems = 0, totalPriceSum = 0;\
\
      appData.groups.forEach(group => \{\
        const groupCount = group.items.length;\
        const groupCheckedCount = group.items.filter(i => i.checked).length;\
        totalItems += groupCount;\
        completedItems += groupCheckedCount;\
\
        group.items.forEach(i => \{\
          if (i.price && !isNaN(i.price)) totalPriceSum += parseFloat(i.price);\
        \});\
\
        const groupEl = document.createElement('div');\
        groupEl.className = 'dotted-box bg-paperCard p-3 transition-all';\
        groupEl.innerHTML = `\
          <div class="flex justify-between items-center dotted-line pb-2 mb-3">\
            <div class="flex items-center gap-2 cursor-pointer flex-1" onclick="toggleGroup('$\{group.id\}')">\
              <i class="fa-solid $\{group.collapsed ? 'fa-caret-right' : 'fa-caret-down'\} text-accentOrange"></i>\
              <span class="font-bold text-base text-brandBrown" onclick="event.stopPropagation(); editGroupName('$\{group.id\}')">$\{escapeHtml(group.name)\}</span>\
              <span class="text-xs text-brandLightBrown">($\{groupCheckedCount\}/$\{groupCount\})</span>\
            </div>\
            <div class="flex items-center gap-3">\
              <button onclick="addItem('$\{group.id\}')" class="text-xs text-accentGreen font-bold hover:underline"><i class="fa-solid fa-plus"></i> \uc0\u26032 \u22686 \u38917 \u30446 </button>\
              <button onclick="deleteGroup('$\{group.id\}')" class="text-xs text-gray-400 hover:text-red-400"><i class="fa-solid fa-trash-can"></i></button>\
            </div>\
          </div>\
          <div class="$\{group.collapsed ? 'hidden' : 'grid grid-cols-2 gap-3'\}">\
            $\{group.items.map(item => `\
              <div class="bg-paper p-2.5 rounded-xl border border-dottedBorder relative flex flex-col justify-between shadow-sm">\
                <button onclick="deleteItem('$\{group.id\}', '$\{item.id\}')" class="absolute top-1.5 right-1.5 text-gray-300 hover:text-red-400 text-xs z-10 p-1"><i class="fa-solid fa-xmark"></i></button>\
                <div class="relative w-full h-28 bg-softGray rounded-lg overflow-hidden mb-2 flex items-center justify-center">\
                  $\{item.image ? `<img src="$\{item.image\}" class="w-full h-full object-cover">` : `<i class="fa-solid fa-image text-2xl text-gray-300"></i>`\}\
                  <label class="absolute bottom-1 right-1 bg-brandBrown/80 text-white rounded-full w-7 h-7 flex items-center justify-center cursor-pointer shadow">\
                    <i class="fa-solid fa-camera text-xs"></i>\
                    <input type="file" accept="image/*" class="hidden" onchange="uploadImage(event, '$\{group.id\}', '$\{item.id\}')">\
                  </label>\
                </div>\
                <div class="flex items-start gap-1.5 mb-2">\
                  <div class="custom-checkbox $\{item.checked ? 'checked' : ''\} mt-0.5 flex-shrink-0" onclick="toggleCheck('$\{group.id\}', '$\{item.id\}')"></div>\
                  <input type="text" value="$\{escapeHtml(item.name)\}" placeholder="\uc0\u21830 \u21697 \u21517 \u31281 " onchange="updateItem('$\{group.id\}', '$\{item.id\}', 'name', this.value)" class="bg-transparent text-xs font-bold text-brandBrown w-full focus:outline-none border-b border-transparent focus:border-accentOrange $\{item.checked ? 'line-through text-gray-400' : ''\}">\
                </div>\
                <input type="text" value="$\{escapeHtml(item.note)\}" placeholder="\uc0\u25976 \u37327  / \u38991 \u33394  / \u20633 \u35387 ..." onchange="updateItem('$\{group.id\}', '$\{item.id\}', 'note', this.value)" class="bg-white/80 px-2 py-1 rounded text-[11px] text-brandLightBrown w-full mb-1.5 border border-dottedBorder focus:outline-none">\
                <div class="relative">\
                  <input type="number" value="$\{item.price\}" placeholder="\uc0\u37329 \u38989 " onchange="updateItem('$\{group.id\}', '$\{item.id\}', 'price', this.value)" class="bg-white/80 px-2 py-1 rounded text-[11px] text-right text-brandBrown w-full border border-dottedBorder focus:outline-none font-mono pr-6">\
                  <span class="absolute right-1.5 top-1 text-[10px] text-gray-400">\uc0\u20870 </span>\
                </div>\
              </div>\
            `).join('')\}\
          </div>\
        `;\
        groupList.appendChild(groupEl);\
      \});\
\
      document.getElementById('completedCount').innerText = completedItems;\
      document.getElementById('totalCount').innerText = totalItems;\
      document.getElementById('totalPrice').innerText = totalPriceSum.toLocaleString();\
    \}\
\
    function toggleGroup(id) \{ const g = appData.groups.find(x => x.id === id); if(g) \{ g.collapsed = !g.collapsed; saveData(); \} \}\
    function addNewGroup() \{ const name = prompt("\uc0\u35531 \u36664 \u20837 \u26032 \u20998 \u39006 \u21517 \u31281 \u65306 ", "\u26032 \u20998 \u39006 "); if(name) \{ appData.groups.push(\{ id: 'g_' + Date.now(), name, collapsed: false, items: [] \}); saveData(); \} \}\
    function editGroupName(id) \{ const g = appData.groups.find(x => x.id === id); if(g) \{ const n = prompt("\uc0\u20462 \u25913 \u20998 \u39006 \u21517 \u31281 \u65306 ", g.name); if(n) \{ g.name = n; saveData(); \} \} \}\
    function deleteGroup(id) \{ if(confirm("\uc0\u30906 \u23450 \u21034 \u38500 \u27492 \u20998 \u39006 \u65311 ")) \{ appData.groups = appData.groups.filter(x => x.id !== id); saveData(); \} \}\
    function addItem(id) \{ const g = appData.groups.find(x => x.id === id); if(g) \{ g.items.push(\{ id: 'i_' + Date.now(), name: '\uc0\u26032 \u21830 \u21697 ', note: '', price: '', image: '', checked: false \}); g.collapsed = false; saveData(); \} \}\
    function updateItem(gId, iId, field, val) \{ const g = appData.groups.find(x => x.id === gId); if(g) \{ const i = g.items.find(x => x.id === iId); if(i) \{ i[field] = val; saveData(); \} \} \}\
    function toggleCheck(gId, iId) \{ const g = appData.groups.find(x => x.id === gId); if(g) \{ const i = g.items.find(x => x.id === iId); if(i) \{ i.checked = !i.checked; saveData(); \} \} \}\
    function deleteItem(gId, iId) \{ const g = appData.groups.find(x => x.id === gId); if(g) \{ g.items = g.items.filter(x => x.id !== iId); saveData(); \} \}\
    function uploadImage(e, gId, iId) \{\
      const file = e.target.files[0]; if(!file) return;\
      const reader = new FileReader();\
      reader.onload = function(evt) \{\
        const img = new Image();\
        img.src = evt.target.result;\
        img.onload = function() \{\
          const canvas = document.createElement('canvas');\
          const ctx = canvas.getContext('2d');\
          const maxW = 300; const scale = maxW / img.width;\
          canvas.width = maxW; canvas.height = img.height * scale;\
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);\
          updateItem(gId, iId, 'image', canvas.toDataURL('image/jpeg', 0.7));\
        \}\
      \};\
      reader.readAsDataURL(file);\
    \}\
    function escapeHtml(str) \{ return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); \}\
    render();\
  </script>\
</body>\
</html>}