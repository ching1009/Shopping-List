\
  <style>\
    body \{\
      background-color: #FBF8F1;\
      font-family: 'Zen Maru Gothic', sans-serif;\
      color: #6B513E;\
      -webkit-tap-highlight-color: transparent;\
      user-select: none;\
    \}\
    .dotted-box \{ border: 2px dashed #D9C3B0; border-radius: 16px; \}\
    .dotted-line \{ border-bottom: 2px dashed #E5D5C5; \}\
    .custom-checkbox \{\
