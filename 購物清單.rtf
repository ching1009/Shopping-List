</head>\
<body class="pb-28 pt-4 px-3 max-w-md mx-auto min-h-screen relative">\
\
  <header class="text-center my-4 dotted-box p-4 bg-paperCard shadow-sm relative">\
    <div class="flex items-center justify-center gap-2 mb-1">\
      <i class="fa-solid fa-pen-nib text-accentOrange text-sm"></i>\
      <h1 id="appTitle" class="text-2xl font-bold text-brandBrown editable-title px-2 py-0.5" contenteditable="true" spellcheck="false">\uc0\u26085 \u26412 \u36092 \u29289 \u33287 \u20195 \u36092 \u31558 \u35352 </h1>\
    </div>\
    <p id="appSubTitle" class="text-xs text-brandLightBrown editable-title px-2 py-0.5 inline-block" contenteditable="true" spellcheck="false">\uc0\u40670 \u25802 \u27492 \u34389 \u21487 \u20462 \u25913 \u21103 \u27161 \u38988 \u33287 \u20633 \u35387 \u35498 \u26126 </p>\
  </header>\
\
  <div class="flex justify-between items-center px-2 mb-4 text-xs font-bold text-brandLightBrown">\
    <div class="flex gap-3">\
      <span>\uc0\u24050 \u23436 \u25104 : <span id="completedCount" class="text-accentGreen text-sm">0</span>/<span id="totalCount">0</span></span>\
      <span>\uc0\u38928 \u31639 \u32317 \u35336 : <span id="totalPrice" class="text-accentOrange text-sm">0</span> \u20870 </span>\
    </div>\
    <button onclick="addNewGroup()" class="bg-brandBrown text-paper px-3 py-1.5 rounded-full text-xs font-normal shadow-sm active:scale-95 transition">\
      <i class="fa-solid fa-plus mr-1"></i>\uc0\u26032 \u22686 \u20998 \u39006 \
    </button>\
